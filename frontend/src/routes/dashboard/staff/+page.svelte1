<script>
  export let data;
  const user = data?.user;
  import { onMount } from 'svelte';
  import { tick } from "svelte";
  import Chart from "chart.js/auto";

  let profileMenuOpen = false;

  function clickOutside(node) {
    const onClick = (e) => { if (!node.contains(e.target)) profileMenuOpen = false; };
    document.addEventListener('click', onClick);
    return { destroy: () => document.removeEventListener('click', onClick) };
  }
  // ======== STATE ========
  let hoveredSlice = null;
  let hoveredTitle = null;

  // ======== STAFF LEAVE DUMMY DATA ========
  const staffLeaveAnnual = {
    taken: [
      { name: "Alya", days: 3 },
      { name: "Azira", days: 4 },
      { name: "Nur",  days: 7 }
    ],
    remaining: [
      { name: "Alya", days: 5 },
      { name: "Azira", days: 3 },
      { name: "Nur",  days: 1 }
    ],
    carry: [
      { name: "Alya", days: 2 },
      { name: "Azira", days: 1 },
      { name: "Nur",  days: 0 }
    ]
  };

  const staffLeaveMedical = {
    taken: [
      { name: "Alya", days: 1 },
      { name: "Azira", days: 0 },
      { name: "Nur",  days: 3 }
    ],
    remaining: [
      { name: "Alya", days: 13 },
      { name: "Azira", days: 14 },
      { name: "Nur",  days: 11 }
    ],
    carry: [
      { name: "Alya", days: 0 },
      { name: "Azira", days: 0 },
      { name: "Nur",  days: 0 }
    ]
  };

  const staffLeaveHosp = {
    taken: [
      { name: "Alya", days: 10 },
      { name: "Azira", days: 2 },
      { name: "Nur",  days: 0 }
    ],
    remaining: [
      { name: "Alya", days: 50 },
      { name: "Azira", days: 58 },
      { name: "Nur",  days: 60 }
    ],
    carry: [
      { name: "Alya", days: 7 },
      { name: "Azira", days: 5 },
      { name: "Nur",  days: 0 }
    ]
  };

  // ======== GET STAFF DATA BASED ON TITLE ========
  function getStaffData(title) {
    if (title.includes("Annual")) return staffLeaveAnnual;
    if (title.includes("Medical")) return staffLeaveMedical;
    if (title.includes("Hospital")) return staffLeaveHosp;
    return staffLeaveAnnual;
  }

  // ======== DONUT STATIC SLICES (120° EACH) ========
  function calcSlices() {
  const totalSlices = 3; // taken, remaining, carry
  const size = 360 / totalSlices;

  return {
    end1: size,           // 120
    end2: size * 2,       // 240
    end3: size * 3        // 360
  };
}


  // ======== SLICE HOVER DETECTION ========
function detectSliceHover(e) {
  const el = e.currentTarget;
  const rect = el.getBoundingClientRect();
  const cx = rect.left + rect.width / 2;
  const cy = rect.top + rect.height / 2;

  const dx = e.clientX - cx;
  const dy = e.clientY - cy;

  let angle = Math.atan2(dy, dx) * 180 / Math.PI;
  angle = (angle + 360 + 90) % 360;

  if (angle < 120) hoveredSlice = "taken";
  else if (angle < 240) hoveredSlice = "remaining";
  else hoveredSlice = "carry";
}



  // ======== DONUT CARD LIST ========
  let donuts = [
    { title: "Staff Annual Leave Summary" },
    { title: "Staff Medical Leave Summary" },
    { title: "Staff Hospitalization Leave Summary" }
  ];

  const pct = (s, t) => (t > 0 ? Math.round((s/t)*100) : 0);

  // ======= Employees Overview State =======
  let loading = true;
  let error = "";
  let dataByDept = [];
  let totalEmployees = 0;
  let canvasEl;

  const palette = [
    "#FFD9CC", "#C6DEF1", "#F2C6DE",
    "#C9E4DE", "#DBCDF0", "#E2F0CB"
  ];

  // ===== FETCH DEPT DATA + RENDER CHART =====
  onMount(async () => {
    try {
      const res = await fetch("http://localhost:5000/api/employee/department-summary");
      if (!res.ok) throw new Error("Failed to load");

      const json = await res.json();

      // fill your array (same as admin)
      dataByDept = json.departments.map((d, i) => ({
        name: d.name,
        count: d.count,
        color: palette[i % palette.length]
      }));

      // calculate totals
      totalEmployees = dataByDept.reduce((a,b)=>a+b.count, 0);

      // now draw chart
      await tick();
      if (canvasEl) {
        new Chart(canvasEl, {
          type: 'bar',
          data: {
            labels: dataByDept.map(d=>d.name),
            datasets: [{
              label: 'Active Employees',
              data: dataByDept.map(d=>d.count),
              backgroundColor: dataByDept.map(d=>d.color),
              borderColor: dataByDept.map(d=>d.color),
              borderWidth: 1,
              borderRadius: 8
            }]
          },
          options: {
            responsive:true,
            maintainAspectRatio:false,
            plugins:{ legend:{ display:false }},
            scales:{
              x:{ ticks:{ autoSkip:false, maxRotation:40, minRotation:0 }},
              y:{ beginAtZero:true }
            }
          }
        });
      }

      loading = false;

    } catch (err) {
      console.error(err);
      error = "Failed to load employee overview";
      loading = false;
    }
  });
</script>

<main class="main">
  <!-- POKOK 'if loading' DIBUANG DARI SINI UNTUK MEMASTIKAN UI SENTIASA KELIHATAN -->
  <div class="grid">
  {#each donuts as d}
    <div class="card">
      <h3 class="donut-title">{d.title}</h3>

      {#key d.title}
        {@const s = calcSlices()}
        {@const sd = getStaffData(d.title)}

        <div class="donut-wrapper">
        <div
        class="donut fancy"
        style={`--size:110px;
          background: conic-gradient(
            #ef4444 0deg ${s.end1}deg,
            #3b82f6 ${s.end1}deg ${s.end2}deg,
            #10b981 ${s.end2}deg 360deg
          );`}
        on:mousemove={(e) => {
          hoveredTitle = d.title;
          detectSliceHover(e, s);
        }}
        on:mouseleave={() => {
          hoveredSlice = null;
          hoveredTitle = null;
        }}
      ></div>



          <!-- Tooltip -->
          {#if hoveredTitle === d.title}
            {#if hoveredSlice === "taken"}
              <div class="donut-hover">
                <div class="hb-title">Taken Leave</div>
                {#each sd.taken as x}
                  <div>{x.name}: {x.days}</div>
                {/each}
              </div>
            {/if}

            {#if hoveredSlice === "remaining"}
              <div class="donut-hover">
                <div class="hb-title">Remaining Leave</div>
                {#each sd.remaining as x}
                  <div>{x.name}: {x.days}</div>
                {/each}
              </div>
            {/if}

            {#if hoveredSlice === "carry"}
              <div class="donut-hover">
                <div class="hb-title">Carry-forward Leave</div>
                {#each sd.carry as x}
                  <div>{x.name}: {x.days}</div>
                {/each}
              </div>
            {/if}
          {/if}
        </div>
      {/key}

     <div class="legend-wrapper">
  <div class="legend-row top">
    <div class="legend-item">
      <span class="chip" style="background:#ef4444"></span>
      <span>Taken Leave</span>
    </div>

    <div class="legend-item">
      <span class="chip" style="background:#3b82f6"></span>
      <span>Remaining Leave</span>
    </div>
  </div>

  <div class="legend-row bottom">
    <div class="legend-item">
      <span class="chip" style="background:#10b981"></span>
      <span>Carry-forward Leave</span>
    </div>
  </div>
</div>
    </div>
  {/each}
    <!-- chart -->
    <div class="card" style="grid-column: span 6;">
      <h3>Total Active Employees</h3>
      <div style="height: 360px;">
        <canvas bind:this={canvasEl}></canvas>
      </div>
    </div>

    <!-- numbers -->
    <div class="card" style="grid-column: span 6;">
      <h3>Employees Overview</h3>
      <div class="stats">
        <div class="stat total-tile">
          <div class="label">Total Employees</div>
          <div class="value">{totalEmployees}</div>
        </div>
        {#each dataByDept as d (d.name)}
          <div class="stat">
            <div class="label"><span class="dot" style="background:{d.color}"></span>{d.name}</div>
            <div class="value">{d.count}</div>
          </div>
        {/each}
      </div>
      <a class="numbers-link" href="/dashboard/admin/employees">View employees</a>
    </div>
  </div>
</main>

<style>
  :root{ --ring:#e5e7eb; --shadow:0 4px 12px rgba(0,0,0,.06); }
  .main {
  padding: 18px;
}

/* === GRID === */
.grid {
  margin-top: 6px;
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(12, 1fr);
}

/* === CARD STYLE (match screenshot) === */
.card{ border:1px solid var(--ring); border-radius:12px; padding:12px; background:#fff; box-shadow:var(--shadow); }

/* === DONUT CARDS — 3 in a row === */
.grid > .card:first-child,
.grid > .card:nth-child(2),
.grid > .card:nth-child(3) {
  grid-column: span 4;   /* 3 cards = 4 + 4 + 4 */
  height: 230px;         /* FIX HEIGHT macam screenshot */
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.donut-title{ font-size:14px; font-weight:700; color:#374151; margin:0 0 6px; }

/* === DONUT CENTERED === */
.donut-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

/* donut circle */
.donut.fancy {
  height: 110px;
  width: 110px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  position: relative;
}

.donut.fancy::after {
  content: "";
  width: 68%;
  height: 68%;
  border-radius: 50%;
  background: white;
  box-shadow: inset 0 0 0 1px #e5e7eb;
  pointer-events: none;   /* 🔥 PENTING — biar mouse tembus */
  position: absolute;
}


/* === TOOLTIP === */
.donut-hover {
  position: absolute;
  top: 50%;
  left: 120%;
  transform: translateY(-50%);
  background: #fff;
  border: 1px solid #e5e7eb;
  padding: 10px 12px;
  font-size: 12px;
  border-radius: 10px;
  box-shadow: 0 2px 12px rgba(0,0,0,.1);
  min-width: 130px;
  pointer-events: none;   /* 🔥 INI FIX UTAMA */
}

/* === LEGEND === */
.legend-wrapper {
  text-align: center;
  margin-top: 10px;
}

.legend-row {
  display: flex;
  justify-content: center;
  gap: 18px;
  font-size: 12px;
  color: #6b7280;
  margin-bottom: 8px; 
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
}

.chip {
  width: 18px;
  height: 8px;
  border-radius: 4px;
}

/* === CHART & EMPLOYEE OVERVIEW === */
.grid > .card:nth-child(4) {
  grid-column: span 7;
}

.grid > .card:nth-child(5) {
  grid-column: span 5;
}

.stats {
  margin-top: 8px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.stat {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 14px;
}

.stat .label {
  font-size: 12px;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 8px;
}

.stat .value {
  font-weight: 800;
  font-size: 28px;
  color: #111827;
}

.numbers-link {
  color: #2563eb;
  font-weight: 600;
  margin-top: 10px;
  display: inline-block;
}
.numbers-link:hover {
  text-decoration: underline;
}

</style>